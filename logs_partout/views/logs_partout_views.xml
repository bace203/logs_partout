<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Which screens keep their history -->
    <record id="ir_model_logs_partout_list" model="ir.ui.view">
        <field name="name">ir.model.list.logs.partout</field>
        <field name="model">ir.model</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="not active_custom_tracking"
                  decoration-success="active_custom_tracking">
                <field name="name" string="Écran"/>
                <field name="model" optional="show"/>
                <field name="active_custom_tracking" string="Historique actif" widget="boolean_toggle" readonly="1"/>
                <field name="tracked_field_count" string="Champs suivis"/>
                <field name="is_logs_partout_default" string="Par défaut" optional="hide"/>
                <button name="action_logs_partout_enable" type="object" string="Suivre tous les champs"
                        icon="fa-history" class="btn-link" invisible="active_custom_tracking"/>
                <button name="action_logs_partout_disable" type="object" string="Arrêter" icon="fa-stop"
                        class="btn-link text-muted" invisible="not active_custom_tracking"/>
                <button name="action_logs_partout_open_history" type="object" string="Historique" icon="fa-list"
                        class="btn-link" invisible="not active_custom_tracking"/>
            </list>
        </field>
    </record>
    <record id="action_logs_partout_models" model="ir.actions.act_window">
        <field name="name">Écrans avec historique</field>
        <field name="res_model">ir.model</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="ir_model_logs_partout_list"/>
        <field name="domain">[('is_mail_thread', '=', True), ('transient', '=', False)]</field>
        <field name="context">{'search_default_logs_active': 1}</field>
        <field name="help" type="html">
            <p>Chaque écran actif garde l'historique de tous ses champs dans son fil de discussion
               (ancienne → nouvelle valeur, qui, quand). « Suivre tous les champs » pour en ajouter un.</p>
        </field>
    </record>
    <record id="ir_model_logs_partout_search" model="ir.ui.view">
        <field name="name">ir.model.search.logs.partout</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="logs_active" string="Historique actif" domain="[('active_custom_tracking', '=', True)]"/>
                <filter name="logs_inactive" string="Sans historique" domain="[('active_custom_tracking', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <!-- Who changed what, when -->
    <record id="mail_tracking_value_logs_partout_list" model="ir.ui.view">
        <field name="name">mail.tracking.value.list.logs.partout</field>
        <field name="model">mail.tracking.value</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="lp_date desc, id desc">
                <field name="lp_date"/>
                <field name="lp_author_id" widget="many2one_avatar"/>
                <field name="lp_model_name"/>
                <field name="lp_record_name"/>
                <field name="lp_field_name"/>
                <field name="lp_old"/>
                <field name="lp_new"/>
                <field name="lp_model" column_invisible="1"/>
                <field name="lp_res_id" column_invisible="1"/>
                <button name="action_lp_open_record" type="object" icon="fa-external-link" title="Ouvrir la fiche"/>
            </list>
        </field>
    </record>
    <record id="mail_tracking_value_logs_partout_search" model="ir.ui.view">
        <field name="name">mail.tracking.value.search.logs.partout</field>
        <field name="model">mail.tracking.value</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="lp_author_id"/>
                <field name="lp_model"/>
                <field name="field_id"/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('lp_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="lp_date" string="Date" date="lp_date"/>
                <group>
                    <filter name="group_author" string="Modifié par" context="{'group_by': 'lp_author_id'}"/>
                    <filter name="group_model" string="Écran" context="{'group_by': 'lp_model'}"/>
                    <filter name="group_field" string="Champ" context="{'group_by': 'field_id'}"/>
                    <filter name="group_day" string="Jour" context="{'group_by': 'lp_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_logs_partout_history" model="ir.actions.act_window">
        <field name="name">Historique des modifications</field>
        <field name="res_model">mail.tracking.value</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mail_tracking_value_logs_partout_list"/>
        <field name="search_view_id" ref="mail_tracking_value_logs_partout_search"/>
    </record>

    <menuitem id="menu_logs_partout_root" name="Historique des modifications" parent="base.menu_administration"
              sequence="1" groups="base.group_system"/>
    <menuitem id="menu_logs_partout_history" name="Qui a changé quoi" parent="menu_logs_partout_root"
              action="action_logs_partout_history" sequence="1"/>
    <menuitem id="menu_logs_partout_models" name="Écrans suivis" parent="menu_logs_partout_root"
              action="action_logs_partout_models" sequence="2"/>
</odoo>
